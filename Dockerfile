# syntax=docker/dockerfile:1.7
# eXo Release Manager image (needs BuildKit: ADD --checksum).
# One Dockerfile for every JDK/Maven combination: the base image selects the toolchain.
#   docker build --build-arg BASE_IMAGE=exoplatform/ci:jdk17-maven39 .
# See build.sh and images.json for the list of published images.
ARG BASE_IMAGE=exoplatform/ci:jdk17-maven39
FROM ${BASE_IMAGE}
# Re-declared: an ARG before FROM is not visible after it
ARG BASE_IMAGE
LABEL maintainer="eXo Platform <docker@exoplatform.com>" \
      org.opencontainers.image.title="eXo Release Manager" \
      org.opencontainers.image.description="Toolchain and release scripts used to release eXo Platform components" \
      org.opencontainers.image.source="https://github.com/exo-docker/exo-release" \
      org.opencontainers.image.base.name="${BASE_IMAGE}"

###
# Versions. Binaries are verified with their sha256 (checked against the upstream checksum files).
###
# Tag or branch of swf-release-manager (override: --build-arg EXOR_VERSION=<branch>)
ARG EXOR_VERSION=1.4.75
ARG JQ_VERSION=1.8.1
ARG JQ_SHA256=020468de7539ce70ef1bceaf7cde2e8c4f2ca6c3afb84642aabc5c97d9fc2a0d
# YAML catalogs of swf-release-manager are converted to JSON with yq
ARG YQ_VERSION=4.54.3
ARG YQ_SHA256=129534601871538efe0ba4c5e62a34fb1d5f469bcb975c4fddeb467d82974973
# Appended to MAVEN_OPTS (start it with a space), e.g. " -Dservers.dir=..." for old GateIn builds
ARG EXTRA_MAVEN_OPTS=""
# git bash completion, pinned to a git release
ARG GIT_COMPLETION_VERSION=v2.50.0
ARG GIT_COMPLETION_SHA256=7e23e7ead6481795f03851d6ad7d7488f49aabd0a209f1cf73f270fe68634b8b

###
# Environment variables needed for eXoR
###
ENV EXOR_VERSION=${EXOR_VERSION}
ENV EXOR_HOME=/opt/exo-release
# The Release Workspace (Volume)
ENV WORKSPACE_DIR=${EXOR_HOME}/workspace/

###
# All paths to store datas in the WORKSPACE_DIR
###
# For JSON catalog and ext API
ENV DATAS_DIR=${WORKSPACE_DIR}/datas
## Logs generated by the process (Maven ...)
ENV LOGS_DIR=${WORKSPACE_DIR}/logs
## Local maven staging respository for releases artifacts
ENV LOCAL_STAGING_DIR=${WORKSPACE_DIR}/local-staging
## Patches ??
ENV PATCHES_DIR=${WORKSPACE_DIR}/patches
# Folder where projects are cloned in. (Volume)
ENV PRJ_DIR=${WORKSPACE_DIR}/projects

###
# All paths for app files
###
# All commands executed by eXoR are here
ENV SCRIPTS_DIR=${EXOR_HOME}/scripts
# Config for Maven, SSH, GIT
ENV CONFIG_DIR=${EXOR_HOME}/config
ENV CREDENTIALS_FILE=${HOME}/.exo_cred
# Tools required (Maven, Git...)
ENV TOOLS_DIR=${EXOR_HOME}/tools
# Dependencies (Tomcat, JBoss) needed for some projects
ENV LOCAL_DEPENDENCIES_DIR=${EXOR_HOME}/exo-dependencies
# Backup for config files
ENV BACKUPS_DIR=${EXOR_HOME}/backup
ENV MAVEN_OPTS="${MAVEN_OPTS}${EXTRA_MAVEN_OPTS}"

USER root
#
# Server directories layout
#
RUN mkdir -p "${CONFIG_DIR}" "${DATAS_DIR}" "${SCRIPTS_DIR}" "${PRJ_DIR}" "${TOOLS_DIR}" "${LOGS_DIR}" \
      "${BACKUPS_DIR}" "${PATCHES_DIR}" "${LOCAL_STAGING_DIR}" "${LOCAL_DEPENDENCIES_DIR}"

## Add Git autocompletion (downloaded and verified by BuildKit)
ADD --checksum=sha256:${GIT_COMPLETION_SHA256} --chmod=644 --chown=${EXO_CI_USER}:${EXO_GROUP} \
    https://raw.githubusercontent.com/git/git/${GIT_COMPLETION_VERSION}/contrib/completion/git-completion.bash \
    ${HOME}/.git-completion.bash

# System packages (Debian/Ubuntu or Alpine base images)
RUN if command -v apt-get >/dev/null 2>&1; then \
      apt-get update && apt-get install -y sudo expect moreutils && apt-get clean && rm -rf /var/lib/apt/lists/*; \
    else \
      apk add --no-cache moreutils openssl; \
    fi

# jq and yq: BuildKit verifies the sha256, a mismatch fails the build
ADD --checksum=sha256:${JQ_SHA256} --chmod=755 \
    https://github.com/jqlang/jq/releases/download/jq-${JQ_VERSION}/jq-linux64 ${TOOLS_DIR}/jq
ADD --checksum=sha256:${YQ_SHA256} --chmod=755 \
    https://github.com/mikefarah/yq/releases/download/v${YQ_VERSION}/yq_linux_amd64 ${TOOLS_DIR}/yq

# Install eXo Release Manager
RUN curl -fsSL --retry 3 "https://github.com/exoplatform/swf-release-manager/archive/${EXOR_VERSION}.tar.gz" \
        | tar xzf - -C "${EXO_CI_TMP_DIR}" --strip-components=1 \
        && cp -R ${EXO_CI_TMP_DIR}/app/conf/* ${CONFIG_DIR} \
        && cp -R ${EXO_CI_TMP_DIR}/app/scripts/* ${SCRIPTS_DIR} \
        && cp -R ${EXO_CI_TMP_DIR}/app/datas/* ${DATAS_DIR} \
        && rm -rf ${EXO_CI_TMP_DIR}/app \
        && chmod u+x ${SCRIPTS_DIR}/*.sh \
        && chmod u+x ${SCRIPTS_DIR}/utils/*.sh

RUN chown -R ${EXO_CI_USER}:${EXO_GROUP} ${EXOR_HOME}

USER ${EXO_CI_USER}

# Secure credentials
ARG ssh_passphrase=default
ARG nexus_token=default
ARG gpg_passphrase=default
ARG jira_auth_header=default
ARG jboss_password=default
RUN echo "ssh_passphrase=`echo -n "$ssh_passphrase" | openssl enc -base64`" >> ${CREDENTIALS_FILE} \
    && echo "nexus_token=`echo -n "$nexus_token" | openssl enc -base64`" >> ${CREDENTIALS_FILE} \
    && echo "gpg_passphrase=`echo -n "$gpg_passphrase" | openssl enc -base64`" >> ${CREDENTIALS_FILE} \
    && echo "jira_auth_header=`echo -n "$jira_auth_header" | openssl enc -base64`" >> ${CREDENTIALS_FILE} \
    && echo "jboss_password=`echo -n "$jboss_password" | openssl enc -base64`" >> ${CREDENTIALS_FILE}

ENTRYPOINT ["/opt/exo-release/scripts/setup-env.sh"]
CMD ["help"]
